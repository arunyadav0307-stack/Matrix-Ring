+            dist = Counter()
+            bad = []
+            for W in subs:
+                dimH, inter, Wp, hrows = hull_by_morita(E, W, s)
+                Wh = mod_of(E.C, [unpair(E.C, tuple(r)) for r in inter])
+                mu = E.mu(Wh)
+                dist[mu] += 1
+                if mu > 2:
