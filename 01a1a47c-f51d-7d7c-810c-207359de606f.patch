+            for j in range(2):
+                want = lincomb([cX[0], cX[1]], [a[R.idx(0, j)], a[R.idx(1, j)]])
+                if cXa[j] != want:
+                    ok_col = False
+            rX, raX = rows(X), rows(R.mul(a, X))
+            for i in range(2):
+                want = lincomb([rX[0], rX[1]], [a[R.idx(i, 0)], a[R.idx(i, 1)]])
+                if raX[i] != want:
+                    ok_row = False
