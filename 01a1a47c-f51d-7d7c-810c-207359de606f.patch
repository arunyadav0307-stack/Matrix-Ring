+    say("      d = min wt(D^{perp_E} \\ Hull_E(D)).")
+    for (q, t, n, s) in [(4, 1, 2, 0), (4, 1, 3, 0), (4, 1, 4, 0)]:
+        res = analyse_case(q, t, n, s, rng, max_codes=0)
