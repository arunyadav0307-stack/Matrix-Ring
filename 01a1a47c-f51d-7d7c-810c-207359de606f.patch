+    say("  symplectic form  Tr(a.b' - a'.b)  (never on F_q-generators only).")
+    say("")
+    say("   (q,t,n,N,kind)   |  N   K   d   c | dim S | dim V | K ok | F_p abelian")
+    say("  " + "-" * 78)
