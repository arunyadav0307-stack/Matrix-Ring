+                break
+        if not (ok_col and ok_row):
+            break
+    check("right action mixes COLUMNS:  col_j(Xa) = sum_k a_kj col_k(X)", ok_col,
+          exhaustive=(len(els) <= 1000 and len(els) <= 60))
+    check("left  action mixes ROWS:     row_i(aX) = sum_k a_ik row_k(X)", ok_row,
+          exhaustive=(len(els) <= 1000 and len(els) <= 60))
+
