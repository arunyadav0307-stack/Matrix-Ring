+                return p
+            fp, gp, hp = prod(Fset), prod(Gset), prod(Hset)
+            fh = pmul(F4, fp, hp)
+            fg = pmul(F4, fp, gp)
+            # ideals in B
+            Ifh, piv_fh = ideal_of_basis(F4, fh, n)
+            If, piv_f = ideal_of_basis(F4, fp, n)
+            Ifg, piv_fg = ideal_of_basis(F4, fg, n)
