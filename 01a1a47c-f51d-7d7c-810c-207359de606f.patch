+
+def say_local(msg):
+    """stdout only: never enters the log (keeps two runs byte-identical)."""
+    print(msg)
+    sys.stdout.flush()
+
+
+def head(msg):
+    say("")
+    say("=" * 78)
+    say(msg)
+    say("=" * 78)
+
+
+def sub(msg):
+    say("")
+    say(msg)
+    say("-" * len(msg))
