+\usepackage[margin=2.6cm]{geometry}
+% NOTE: \usepackage[T1]{fontenc} is intentionally NOT used.  See
+% compile/README.md: the recovered engine's texmf tree has no EC (T1)
+% font metrics, so T1 silently falls back to nullfont.  OT1 (the
+% article-class default) renders this manuscript identically: the .tex
+% sources contain no non-ASCII characters.  On a current TeX Live,
+% either setting compiles.
+\usepackage[utf8]{inputenc}
+\usepackage{amsmath,amssymb,amsthm}
+\usepackage{array,booktabs,longtable}
+\usepackage{enumitem}
+\usepackage{xcolor}
+\usepackage{url}
+% File and directory names are long and contain underscores, so they are set
+% with url.sty's \path, which may break at '_', '/' and '.'.  A plain
+% \texttt{...} cannot break there and pushes into the margin.
+\newcommand{\filepath}{\path}
+% Typesetting: allow extra interword stretch on lines that would otherwise be
+% pushed into the right margin.  This is a last-resort stretch (TeX's third
+% pass) and is only used on lines that would otherwise be overfull; it never
+% loosens a line that sets correctly.
+\emergencystretch=2em
+% Author metadata placeholder.  This must be defined BEFORE \hypersetup:
+% hyperref expands the PDF metadata strings (pdfauthor and friends) when
+% \hypersetup runs, not at \begin{document}, so a placeholder used in
+% pdfauthor but defined later in the preamble is an undefined control
+% sequence.  Older hyperref releases deferred the expansion; current ones
+% do not.  See compile/BUILD_CORRECTIONS.md, correction C-1.
+\newcommand{\AUTHORPLACEHOLDER}{%
+  \texorpdfstring{\textbf{[\,AUTHOR METADATA TO BE SUPPLIED\,]}}%
+                 {[AUTHOR METADATA TO BE SUPPLIED]}}
+% pdfusetitle makes hyperref copy \title and \author into the PDF document
+% information dictionary; without it the /Title field of the PDF is empty.
+% \texorpdfstring above supplies the plain-text form used there, because a
+% PDF string cannot carry \textbf or \, (a kern) -- hyperref silently strips
