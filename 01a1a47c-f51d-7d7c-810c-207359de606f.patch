+                "theta=sig o T (R-valued)", "trace (F_q-valued)",
+                "trace-sigma (F_q-valued)", "trace-theta (F_q-valued)"]
+    say("ambient F_q-dimension = %d, |R| = %d" % (rep["ambient_dim"],
+                                                  rep["ring_size"]))
+    for side in ("left ideals", "right ideals"):
+        blk = rep[side]
