+    check("%s: dim Hull = 2 dim_{F_q}(W(C) n W(C^{perp_s}))  (Morita)" % tag,
+          bad_mor == 0, "%d codes, %d violations" % (len(rets), bad_mor), exh)
+
+    # ---- C2  Morita, as sets, and |I_W| = |W|^2 -------------------------
+    bad = 0
+    for R in rets:
+        if R["hull_M"] != R["hull_D"]:
