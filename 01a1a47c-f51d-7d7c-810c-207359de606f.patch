+# ==========================================================================
+# 1.  The rings
+# ==========================================================================
+
+class BRing(object):
+    """
+    B = A_t[X]/<X^n - 1>.
+
+    An element is a tuple of length t*n of F_q-elements, indexed  a*n + e,
+    i.e.  sum_{a<t} sum_{e<n} c_{a,e} u^a X^e.
+    """
+
+    def __init__(self, F, t, n):
+        self.F, self.t, self.n = F, t, n
+        self.dim = t * n
+        self.zero = tuple([0] * (t * n))
+        one = [0] * (t * n)
+        one[0] = 1
+        self.one = tuple(one)
+
+    def add(self, x, y):
+        F = self.F
+        return tuple(F.add[x[i]][y[i]] for i in range(self.dim))
+
+    def neg(self, x):
+        return tuple(self.F.neg[c] for c in x)
+
+    def sub(self, x, y):
+        return self.add(x, self.neg(y))
+
+    def mul(self, x, y):
+        F, t, n = self.F, self.t, self.n
+        out = [0] * (t * n)
+        for a1 in range(t):
+            row1 = x[a1 * n:(a1 + 1) * n]
+            if not any(row1):
+                continue
+            for e1 in range(n):
+                c1 = row1[e1]
+                if not c1:
+                    continue
+                for a2 in range(t - a1):
+                    row2 = y[a2 * n:(a2 + 1) * n]
+                    if not any(row2):
+                        continue
+                    base = (a1 + a2) * n
+                    for e2 in range(n):
+                        c2 = row2[e2]
+                        if c2:
+                            k = base + (e1 + e2) % n
+                            out[k] = F.add[out[k]][F.mul[c1][c2]]
+        return tuple(out)
+
+    def sigma(self, x, s):
+        tab = self.F.frob[s % self.F.r]
+        return tuple(tab[c] for c in x)
+
+    def rev(self, x):
+        """the substitution X -> X^{n-1} = X^{-1}; u is fixed"""
+        t, n = self.t, self.n
+        out = [0] * (t * n)
+        for a in range(t):
+            for e in range(n):
+                out[a * n + ((-e) % n)] = x[a * n + e]
+        return tuple(out)
+
+    def u_pow(self, a0):
+        """u^{a0}"""
+        n, t = self.n, self.t
+        out = [0] * (t * n)
+        if a0 < t:
+            out[a0 * n] = 1
+        return tuple(out)
+
+    def X_pow(self, e0):
+        out = [0] * (self.t * self.n)
+        out[e0 % self.n] = 1
+        return tuple(out)
+
+    def elem_list(self):
+        return list(itertools.product(range(self.F.q), repeat=self.dim))
+
+
+class QuotRing(object):
+    """
+    A generic commutative quotient  C = A_t[X]/<h>,  h monic of degree D.
+
+    An element is a tuple of length t*D indexed  a*D + b  (u^a X^b).
+    Only the operations needed for the chain-ring components are provided.
+    """
+
+    def __init__(self, F, t, h):
+        self.F, self.t, self.h, self.D = F, t, tuple(h), len(h) - 1
+        self.dim = t * self.D
+        self.zero = tuple([0] * self.dim)
+        one = [0] * self.dim
+        one[0] = 1
+        self.one = tuple(one)
+
+    def add(self, x, y):
+        F = self.F
+        return tuple(F.add[x[i]][y[i]] for i in range(self.dim))
+
+    def neg(self, x):
+        return tuple(self.F.neg[c] for c in x)
+
+    def sub(self, x, y):
+        return self.add(x, self.neg(y))
+
+    def _reduce(self, poly):
+        """reduce a length-(D + k) X-polynomial modulo the monic h"""
+        F, D, h = self.F, self.D, self.h
+        p = list(poly)
+        for i in range(len(p) - 1, D - 1, -1):
+            c = p[i]
+            if c:
+                p[i] = 0
+                for j in range(D):
+                    # h = [h_0, ..., h_D] with h_D = 1 ;  X^i = -sum h_j X^{i-D+j}
+                    p[i - D + j] = F.sub[p[i - D + j]][F.mul[c][h[j]]]
+        return p[:D]
+
+    def mul(self, x, y):
+        F, t, D = self.F, self.t, self.D
+        conv = [0] * (2 * D - 1)
+        for i in range(D):
+            if x[i]:
+                for j in range(D):
+                    if y[j]:
+                        conv[i + j] = F.add[conv[i + j]][F.mul[x[i]][y[j]]]
+        out = [0] * (t * D)
+        for a1 in range(t):
+            row1 = x[a1 * D:(a1 + 1) * D]
+            if not any(row1):
+                continue
+            for a2 in range(t - a1):
+                row2 = y[a2 * D:(a2 + 1) * D]
+                if not any(row2):
+                    continue
+                conv = [0] * (2 * D - 1)
+                for i in range(D):
+                    if row1[i]:
+                        for j in range(D):
+                            if row2[j]:
+                                conv[i + j] = F.add[conv[i + j]][F.mul[row1[i]][row2[j]]]
+                red = self._reduce(conv)
+                base = (a1 + a2) * D
+                for b in range(D):
+                    out[base + b] = F.add[out[base + b]][red[b]]
+        return tuple(out)
+
+    def sigma(self, x, s):
+        tab = self.F.frob[s % self.F.r]
+        return tuple(tab[c] for c in x)
+
+    def elem_list(self):
+        return list(itertools.product(range(self.F.q), repeat=self.dim))
+
