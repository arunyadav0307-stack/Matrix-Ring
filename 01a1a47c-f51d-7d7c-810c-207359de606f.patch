+    say("      triples satisfying h = h* and g = f* : %d"
+        % sum(1 for r in rows1
+              if reciprocal(F4, ptrim(r["h"])) == ptrim(r["h"])
+              and reciprocal(F4, ptrim(r["f"])) == ptrim(r["g"])))
+    for r in rows1:
