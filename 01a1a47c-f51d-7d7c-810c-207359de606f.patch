+                    row["dim"], e["dual_dim"],
+                    "OK " if e["perfect"] else "BAD",
+                    e["dual_side"][:6])))
+            say("  %-6d %-12d %s" % (row["dim"], row["size"], "".join(cells)))
+    say()
+    say("  legend: 'k+d=OK' means dim(C) + dim(C^perp) = dim(R) (perfect")
+    say("  duality); the last word is the module side of the dual code.")
