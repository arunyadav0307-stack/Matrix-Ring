+    wrong.D = 5
+    m = (1,)
+    for _ in range(5):
+        m = pmul(m, (F.neg[1], 1), F)           # (X-1)^5 : a FALSE factorisation
+    wrong.facs = [((F.neg[1], 1), 5)]
