+              bad == 0, "%d codes, sets enumerated" % ndone, True)
+    else:
+        say("     note: |I_W| = |W|^2 enumeration skipped at %s (too large)" % tag)
+
+    # ---- C4  parity and principality of the hull ------------------------
+    odd = 0
+    for R in rets:
