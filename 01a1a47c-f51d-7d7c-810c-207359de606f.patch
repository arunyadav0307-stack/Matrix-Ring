+    check("(%d,%d,%d): phi_R additive" % (q, t, n), ok_add,
+          "%d pairs" % len(pairs), exh)
+    # scalar c in F_q acts on R as the central matrix c*I, so:
+    ok_hom2 = True
+    cI = [RA.scalar_mat(RA.A.scalar(c, RA.A.one)) for c in range(q)]
+    for X in ex[:200]:
+        for c in range(q):
