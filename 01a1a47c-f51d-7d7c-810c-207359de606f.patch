+def boundary_cases():
+    """the degenerate codes: zero, ambient, and n = 1"""
+    sub("boundary cases")
+    for (q, t, n) in [(4, 1, 1), (4, 1, 2), (4, 2, 1), (4, 2, 2)]:
+        E = Ring3B(q, t, n)
+        G_words = ambient_words(E)
+        for s in range(E.r):
