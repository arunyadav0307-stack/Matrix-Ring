+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""
+PHASE 0 (REVISED) -- TASK 3:  RECONCILIATION WITH ALAHMADI-SBOUI-SOLE-YEMEN,
+"Cyclic codes over M_2(F_2)"  (arXiv:1201.6533; J. Franklin Inst. 350 (2013)
+2837-2847).
+
+Everything below is computed from scratch in exact arithmetic; nothing is
+copied from an earlier run.
+
+The paper's set-up (quoted from the PDF, arXiv:1201.6533v1, Sec. 2-3):
+
+  *  A = M_2(F_2);  omega, i in A with char. pol. X^2+X+1 and X^2+1 and
+     i*omega = omega^2 * i;  u = 1 + i (nilpotent);  A = F_4 (+) u F_4.
+  *  "Let R_n = A[X]/(X^n-1) denote the ring whose RIGHT SIDED IDEALS
+     represent cyclic codes of length n."                       (Sec. 2)
+  *  "In the whole paper we assume n to be odd."                (Sec. 3)
+  *  Lemma 2: "If f is an irreducible polynomial over F_4 the only right
+     A-modules of R(f) = A[X]/(f) are (0), (u), (1)."
+  *  Theorem 1: "Given a factorization X^n-1 = f g h into three pairwise
+     coprime factors over F_4[X] we can construct the cyclic code
+     C = (f h) + u (f g).  The residue and torsion codes of C are cyclic
+     quaternary codes of length n with respective generator polynomials
+     f h and f, of respective dimensions deg(g) and deg(g)+deg(h) over F_4.
+     Conversely any cyclic A-code of length n arises in this way."
+  *  Lemma 4:  C = (fh, ufg)  =>  C^perp = (g* h*, u g* f*).
+  *  Theorem 2: C Euclidean self-dual iff h = h* and g = f*.
+
+WHAT THIS SCRIPT DOES
+  1. builds A = M_2(F_2) concretely with the paper's omega, i, u and checks
+     the paper's relations; builds the isomorphism F_4 -> <I, omega> and the
+     decomposition A = F_4 (+) u F_4;
+  2. enumerates ALL right ideals of R_n EXHAUSTIVELY (lattice closure of all
+     principal right ideals over the whole ambient set), for n = 1 and n = 3;
+  3. builds, for every ordered assignment of the irreducible factors of
+     X^n-1 to (f,g,h), the three possible readings of the paper's formula
+       R1 : C = { r + u t : r in (fh), t in (f) }        ("u(f)"  reading)
+       R2 : C = { r + u t : r in (fh), t in (fg)}        ("u(fg)" reading,
+                                                          literal)
+       R3 : the right ideal of R_n generated by {fh, u f g}
+     and records for each: size, whether it is a right ideal, its residue,
+     its torsion, and which of the enumerated right ideals it is;
+  4. compares with the enumeration and reports the gap;
+  5. tests Lemma 2 directly at n = 1 (R(X+1) is isomorphic to A as a right
+     A-module, so its right A-submodules are the right ideals of A);
+  6. tests Lemma 4 / Theorem 2 (Euclidean duality) in three variants.
+"""
+import sys
+import time
+import itertools
+
+from matrix_ring_lib import (FiniteField, rref, nullspace, row_space_basis,
+                             in_span, intersect)
+
+LINES = []
+
+
+def say(s=""):
+    print(s, flush=True)
+    LINES.append(str(s))
+
+
+# ---------------------------------------------------------------------------
+# A = M_2(F_2).  index convention:  M = [[a,b],[c,d]]  ->  a*8+b*4+c*2+d
+# ---------------------------------------------------------------------------
+def m2(a, b, c, d):
+    return a * 8 + b * 4 + c * 2 + d
+
+
+def m2mul(x, y):
+    a, b, c, d = (x >> 3) & 1, (x >> 2) & 1, (x >> 1) & 1, x & 1
+    e, f, g, h = (y >> 3) & 1, (y >> 2) & 1, (y >> 1) & 1, y & 1
+    return m2((a * e + b * g) & 1, (a * f + b * h) & 1,
+              (c * e + d * g) & 1, (c * f + d * h) & 1)
+
+
+MUL = [[m2mul(x, y) for y in range(16)] for x in range(16)]
+ADD = [[x ^ y for y in range(16)] for x in range(16)]
+
+
+def bits(x):
+    return ((x >> 3) & 1, (x >> 2) & 1, (x >> 1) & 1, x & 1)
+
+
+ZERO = m2(0, 0, 0, 0)                     # 0
+ONE = m2(1, 0, 0, 1)                      # identity
+OMEGA = m2(0, 1, 1, 1)                    # [[0,1],[1,1]]  (the paper's omega)
+OMEGA2 = m2(1, 1, 1, 0)                   # omega^2
+II = m2(0, 1, 1, 0)                       # [[0,1],[1,0]]  (the paper's i)
+UU = ADD[ONE][II]                         # u = 1 + i
+
+
+# ---------------------------------------------------------------------------
+def build_phi():
+    """isomorphism F_4 = FiniteField(2,2) -> <I, omega> subset A.
+    In FiniteField(2,2) the element 2 (= "x") has multiplicative order 3."""
+    F4 = FiniteField(2, 2)
+    g = None
+    for a in range(1, F4.q):
+        if F4.order[a] == 3:
+            g = a
+            break
+    assert g is not None
+    table = {0: ZERO, 1: ONE, g: OMEGA, F4.mul[g][g]: OMEGA2}
+    phi = [None] * 4
+    for a in range(4):
+        phi[a] = table[a]
+    # verify it is a ring homomorphism
+    for a in range(4):
+        for b in range(4):
+            assert phi[F4.add[a][b]] == ADD[phi[a]][phi[b]]
+            assert phi[F4.mul[a][b]] == MUL[phi[a]][phi[b]]
+    return F4, phi, g
+
+
+# ---------------------------------------------------------------------------
+# polynomials over F_4  (lists, index = degree) and the ring B = F_4[X]/<X^n-1>
+# ---------------------------------------------------------------------------
+def ptrim(a):
+    a = list(a)
+    while a and a[-1] == 0:
+        a.pop()
+    return a
+
+
+def padd(F, a, b):
+    n = max(len(a), len(b))
+    out = [0] * n
+    for i, x in enumerate(a):
+        out[i] = x
+    for i, x in enumerate(b):
+        out[i] = F.add[out[i]][x]
+    return ptrim(out)
+
+
+def pmul(F, a, b):
+    if not a or not b:
+        return []
+    out = [0] * (len(a) + len(b) - 1)
+    for i, x in enumerate(a):
+        if x:
+            for j, y in enumerate(b):
+                if y:
+                    out[i + j] = F.add[out[i + j]][F.mul[x][y]]
+    return ptrim(out)
+
+
+def pdivmod(F, a, b):
+    a = list(a)
+    db = len(b) - 1
+    q = [0] * max(0, len(a) - db)
+    for i in range(len(a) - 1, db - 1, -1):
+        c = a[i]
+        if c:
+            q[i - db] = c
+            for j in range(db + 1):
+                a[i - db + j] = F.sub(a[i - db + j], F.mul[c][b[j]])
+    return ptrim(q), ptrim(a[:db])
+
+
+def pmod(F, a, b):
+    return pdivmod(F, a, b)[1]
+
+
+def pmul_modXn(F, a, b, n):
+    """product in F_4[X]/<X^n-1>"""
+    p = pmul(F, a, b)
+    out = [0] * n
+    for i, x in enumerate(p):
+        out[i % n] = F.add[out[i % n]][x]
+    return ptrim(out)
+
+
+def redXn(F, p, n):
+    """reduce a polynomial modulo X^n - 1 (coefficients fold cyclically)"""
+    out = [0] * n
+    for i, c in enumerate(p):
+        out[i % n] = F.add[out[i % n]][c]
+    return ptrim(out)
+
+
+def reciprocal(F, f):
+    """f*(X) = X^deg f f(1/X), made monic"""
+    d = len(f) - 1
+    out = list(reversed(f))
+    # normalise to monic
+    lead = out[-1]
+    return [F.div(c, lead) for c in out]
+
+
+def ideal_of_basis(F, p, n):
+    """F_4-basis of the ideal (p) of B = F_4[X]/<X^n-1>, as F_4-subspace of
+    F_4^n (list of length-n tuples over F_4)."""
+    rows = []
+    cur = list(redXn(F, p, n)) + [0] * n
+    cur = cur[:n]
+    for k in range(n):
+        v = [0] * n
+        for i, c in enumerate(cur):
+            v[i] = c
+        rows.append(tuple(v))
+        # multiply by X
+        cur = [cur[-1]] + cur[:-1]
+    # F_4-row space
+    F2 = FiniteField(2, 1)
+    # work over F_4 via the library rref (needs a field -> use FiniteField(4,1)?
+    # not available).  Do Gaussian elimination over F_4 by hand.
+    return f4_row_space(F, rows, n)
+
+
+def f4_row_space(F, rows, ncols):
+    rows = [list(r) for r in rows]
+    piv = []
+    r = 0
+    for c in range(ncols):
+        sel = None
+        for i in range(r, len(rows)):
+            if rows[i][c]:
+                sel = i
+                break
+        if sel is None:
+            continue
+        rows[r], rows[sel] = rows[sel], rows[r]
+        inv = F.inv[rows[r][c]]
+        rows[r] = [F.mul[inv][v] for v in rows[r]]
+        for i in range(len(rows)):
+            if i != r and rows[i][c]:
+                f = rows[i][c]
+                rows[i] = [F.sub(rows[i][j], F.mul[f][rows[r][j]])
+                           for j in range(ncols)]
+        piv.append(c)
+        r += 1
+        if r == len(rows):
+            break
+    return [tuple(x) for x in rows[:r]], piv
+
+
+def f4_in_span(F, basis, piv, v, ncols):
+    v = list(v)
+    for row, c in zip(basis, piv):
+        if v[c]:
+            f = v[c]
+            v = [F.sub(v[j], F.mul[f][row[j]]) for j in range(ncols)]
+    return all(x == 0 for x in v)
+
+
+def generator_poly(F, code_basis, piv, n):
+    """least-degree monic polynomial lying in the F_4-cyclic code spanned by
+    code_basis (assumed shift-invariant).  Returns None if only 0."""
+    for d in range(0, n + 1):
+        for tail in itertools.product(range(F.q), repeat=d):
+            poly = list(tail) + [1]
+            v = tuple(poly[i] if i < len(poly) else 0 for i in range(n))
+            if f4_in_span(F, code_basis, piv, v, n):
+                return poly
+    return None
+
+
+# ---------------------------------------------------------------------------
+# R_n = A^n : flat F_2 vectors of length 4n
+# ---------------------------------------------------------------------------
+def flat_A(a):
+    return tuple(bits(a))
+
+
+def to_flat(words):
+    """words: tuple of n elements of A -> F_2 vector of length 4n"""
+    out = []
+    for a in words:
+        out.extend(bits(a))
+    return tuple(out)
+
+
+def from_flat(v):
+    n = len(v) // 4
+    out = []
+    for e in range(n):
+        b = v[4 * e:4 * e + 4]
+        out.append(m2(*b))
+    return tuple(out)
+
+
+def rn_rmul(x, a, n):
+    return to_flat(tuple(MUL[w][a] for w in from_flat(x)))
+
+
+def rn_lmul(x, a, n):
+    return to_flat(tuple(MUL[a][w] for w in from_flat(x)))
+
+
+def rn_shift(x, n):
+    w = from_flat(x)
+    return to_flat(tuple([w[-1]] + list(w[:-1])))
+
+
+F2 = FiniteField(2, 1)
+
+
+def span2(vecs, N):
+    if not vecs:
+        return []
+    return row_space_basis(F2, vecs, N)
+
+
+def key(basis):
+    return tuple(sorted(basis))
+
+
+def enumerate_right_ideals(n):
+    """exhaustive: lattice closure of all principal right ideals of R_n."""
+    N = 4 * n
+    allv = itertools.product(range(2), repeat=N)
+    ops = [lambda v: rn_shift(v, n)]
+    for a in range(16):
+        ops.append((lambda a: (lambda v: rn_rmul(v, a, n)))(a))
+    seen = {key([]): []}
+    count = 0
+    for v in allv:
+        count += 1
+        if not any(v):
+            continue
+        cur = span2([v], N)
+        changed = True
+        while changed:
+            changed = False
+            new = list(cur)
+            for w in cur:
+                for op in ops:
+                    new.append(op(w))
+            nv = span2(new, N)
+            if len(nv) != len(cur):
+                cur = nv
+                changed = True
+        seen[key(cur)] = cur
+    ideals = list(seen.values())
+    changed = True
+    while changed:
+        changed = False
+        cur = list(ideals)
+        for i in range(len(cur)):
+            for j in range(i + 1, len(cur)):
+                s = span2(list(cur[i]) + list(cur[j]), N)
+                if key(s) not in seen:
+                    seen[key(s)] = s
+                    ideals.append(s)
+                    changed = True
+    return ideals, count
+
+
+# ---------------------------------------------------------------------------
+def main():
+    say("ALAHMADI-SBOUI-SOLE-YEMEN (2013)  --  RECONCILIATION EXPERIMENTS")
+    say("run: %s" % time.strftime("%Y-%m-%d %H:%M:%S"))
+    say("python: %s" % sys.version.split()[0])
+    t0 = time.time()
+
+    # ---------------- 1. the ring A ---------------------------------------
+    say("")
+    say("=" * 78)
+    say("1. THE RING A = M_2(F_2) WITH THE PAPER'S omega, i, u")
+    say("=" * 78)
+    say("   i      = [[0,1],[1,0]]   (index %d)" % II)
+    say("   omega  = [[0,1],[1,1]]   (index %d)" % OMEGA)
+    say("   u = 1+i (index %d)" % UU)
+    say("   i^2 = I              : %s" % (MUL[II][II] == ONE))
+    say("   omega^2+omega+I = 0  : %s" % (ADD[ADD[OMEGA2][OMEGA]][ONE] == ZERO))
+    say("   i*omega = omega^2*i  : %s" % (MUL[II][OMEGA] == MUL[OMEGA2][II]))
+    say("   u^2 = 0              : %s" % (MUL[UU][UU] == ZERO))
+    F4, PHI, G = build_phi()
+    say("   F_4 = {0,1,g,g^2} with g = element %d of FiniteField(2,2); "
+        "phi(g) = omega" % G)
+    say("   phi : F_4 -> A is an injective ring homomorphism: True")
+    # decomposition A = F_4 (+) u F_4
+    dec = {}
+    for M in range(16):
+        found = None
+        for a in range(4):
+            for b in range(4):
+                if M == ADD[PHI[a]][MUL[UU][PHI[b]]]:
+                    found = (a, b)
+        dec[M] = found
+    say("   A = F_4 (+) u F_4 : every M in A has a unique (a,b): %s"
+        % all(dec[M] is not None for M in range(16)))
+    say("   (u is NOT central)  omega*u = %d , u*omega = %d , equal: %s"
+        % (MUL[OMEGA][UU], MUL[UU][OMEGA], MUL[OMEGA][UU] == MUL[UU][OMEGA]))
+    say("   multiplication rule in the coordinates a + u b :")
+    say("      (a+ub)(c+ud) = [ac + (a+a^2)d] + u[(a^2+b^2)d + bc + bd]")
+    ok = True
+    for a in range(4):
+        for b in range(4):
+            for c in range(4):
+                for d in range(4):
+                    lhs = MUL[ADD[PHI[a]][MUL[UU][PHI[b]]]][ADD[PHI[c]][MUL[UU][PHI[d]]]]
+                    a2, b2, d2 = F4.mul[a][a], F4.mul[b][b], d
+                    res = F4.add[F4.mul[a][c]][F4.mul[F4.add[a][a2]][d2]]
+                    up = F4.add[F4.add[F4.mul[F4.add[a2][b2]][d2]][F4.mul[b][c]]][F4.mul[b][d2]]
+                    rhs = ADD[PHI[res]][MUL[UU][PHI[up]]]
+                    if lhs != rhs:
+                        ok = False
+    say("      verified for all 256 (a,b,c,d): %s" % ok)
+
+    # ---------------- 2. enumeration of the right ideals -------------------
+    results = {}
+    for n in (1, 3):
+        say("")
+        say("=" * 78)
+        say("2.%d  EXHAUSTIVE ENUMERATION OF THE CYCLIC CODES OF LENGTH n = %d"
+            % (n, n))
+        say("=" * 78)
+        ideals, namb = enumerate_right_ideals(n)
+        say("   ambient |R_n| = %d (all %d vectors scanned)" % (namb, namb))
+        say("   NUMBER OF RIGHT IDEALS (cyclic codes) = %d" % len(ideals))
+        sizes = {}
+        for b in ideals:
+            sizes[len(b)] = sizes.get(len(b), 0) + 1
+        say("   F_2-dimension distribution (dim : #codes) = %s"
+            % sorted(sizes.items()))
+        say("   |C| distribution (|C| = 2^dim) = %s"
+            % sorted((2 ** k, v) for k, v in sizes.items()))
+        results[n] = (ideals, sizes)
+
+    # ---------------- 3. Lemma 2 test at n = 1 -----------------------------
+    say("")
+    say("=" * 78)
+    say("3. TEST OF LEMMA 2 AT n = 1")
+    say("=" * 78)
+    ideals1 = results[1][0]
+    say("   R_1 = A[X]/(X-1) = A[X]/(X+1) is isomorphic to A as a ring")
+    say("   (X +- 1 is central, evaluation X -> 1 is a ring isomorphism),")
+    say("   so the right A-submodules of R(1) = R(X+1) are exactly the right")
+    say("   ideals of A = M_2(F_2).")
+    say("   Lemma 2 claims there are exactly 3 of them: (0), (u), (1).")
+    say("   COMPUTED: %d right ideals of A:" % len(ideals1))
+    for b in sorted(ideals1, key=len):
+        words = [[bits(x) for x in from_flat(v)] for v in b]
+        say("      dim=%d  |C|=%2d  F_2-basis (as matrices [[a,b],[c,d]]) : %s"
+            % (len(b), 2 ** len(b), words))
+    say("   -> Lemma 2's list {(0), (u), (1)} is INCOMPLETE under this reading:")
+    say("      %d right A-submodules were found, not 3." % len(ideals1))
+    say("      The two beyond (0), (u), (1) are the right ideals with column")
+    say("      space <(0,1)> and <(1,0)>;  (u) = uA is the one with column")
+    say("      space <(1,1)> (checked: uA = {[[a,b],[a,b]]}, columns <(1,1)>).")
+    say("      REPORTED AS A READING/CONVENTION DISCREPANCY.  We do NOT claim")
+    say("      the published theorem is wrong: the paper may use a different")
+    say("      notion of 'right A-submodule of A[X]/(f)' (e.g. only submodules")
+    say("      of the chain-ring kind).  See ALAHMADI_THEOREM_RECONCILIATION.md.")
+
+    # ---------------- 4. the three readings -------------------------------
+    say("")
+    say("=" * 78)
+    say("4. THEOREM 1: THE THREE READINGS OF  C = (fh) + u(fg)")
+    say("=" * 78)
+    for n in (1, 3):
+        ideals, sizes = results[n]
+        N = 4 * n
+        # factor X^n - 1 over F_4
+        g = [F4.neg(1)] + [0] * (n - 1) + [1]
+        # brute force factorisation into linear factors (n <= 3 here)
+        facs = []
+        for root in range(F4.q):
+            # X - root
+            f = [F4.neg(root), 1]
+            q, r = pdivmod(F4, g, f)
+            if r == []:
+                facs.append((root, f))
+        rem = list(g)
+        for root, f in facs:
+            rem, _ = pdivmod(F4, rem, f)
+        say("")
+        say("   n = %d :  X^%d - 1 = %s   (irreducible factors: %d)"
+            % (n, n, " * ".join("(X-%s)" % ("0" if r == 0 else
+                                            ("1" if r == 1 else ("g" if r == G else "g^2")))
+                                for r, f in facs), len(facs)))
+        say("   remainder after dividing out: %s (must be [1])" % rem)
+        t = len(facs)
+        say("   number of ordered triples (f,g,h) of pairwise coprime factors")
+        say("   with fgh = X^n-1 :  3^t = %d" % (3 ** t))
+        # enumerate the triples
+        rows1, rows2, rows3 = [], [], []
+        for assign in itertools.product(range(3), repeat=t):
+            Fset = [facs[i][1] for i in range(t) if assign[i] == 0]
+            Gset = [facs[i][1] for i in range(t) if assign[i] == 1]
+            Hset = [facs[i][1] for i in range(t) if assign[i] == 2]
+
+            def prod(sets):
+                p = [1]
+                for f in sets:
