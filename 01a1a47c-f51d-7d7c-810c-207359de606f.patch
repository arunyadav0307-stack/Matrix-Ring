+            % (q, t, n, s, res["N"], res["euclid"], res["TT"] is not None,
+               res["nso"], res["ndc"]))
+        say("       best self-orthogonal  (d,k,K,hull,d(D)) = %s"
+            % (res["bestso"],))
+        say("       best dual-containing  (d,k,K,hull)      = %s"
