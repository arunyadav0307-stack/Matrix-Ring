+            r["hull_dot_dim"], r["hull_theta_dim"], r["hull_ttheta_dim"],
+            "yes" if r["hull_ttheta_is_right"] else "NO"))
+    say()
+    say("  'theta'  = pairing  sum_i theta_s(x_i) y_i  with theta_s = "
+        "sigma_s o transpose")
