+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""
+PHASE 0 (REVISED) -- TASK 3:  RECONCILIATION WITH ALAHMADI-SBOUI-SOLE-YEMEN,
+"Cyclic codes over M_2(F_2)"  (arXiv:1201.6533; J. Franklin Inst. 350 (2013)
+2837-2847).
+
+Everything below is computed from scratch in exact arithmetic; nothing is
+copied from an earlier run.
+
+The paper's set-up (quoted from the PDF, arXiv:1201.6533v1, Sec. 2-3):
+
+  *  A = M_2(F_2);  omega, i in A with char. pol. X^2+X+1 and X^2+1 and
+     i*omega = omega^2 * i;  u = 1 + i (nilpotent);  A = F_4 (+) u F_4.
+  *  "Let R_n = A[X]/(X^n-1) denote the ring whose RIGHT SIDED IDEALS
+     represent cyclic codes of length n."                       (Sec. 2)
+  *  "In the whole paper we assume n to be odd."                (Sec. 3)
+  *  Lemma 2: "If f is an irreducible polynomial over F_4 the only right
+     A-modules of R(f) = A[X]/(f) are (0), (u), (1)."
+  *  Theorem 1: "Given a factorization X^n-1 = f g h into three pairwise
+     coprime factors over F_4[X] we can construct the cyclic code
+     C = (f h) + u (f g).  The residue and torsion codes of C are cyclic
+     quaternary codes of length n with respective generator polynomials
+     f h and f, of respective dimensions deg(g) and deg(g)+deg(h) over F_4.
+     Conversely any cyclic A-code of length n arises in this way."
+  *  Lemma 4:  C = (fh, ufg)  =>  C^perp = (g* h*, u g* f*).
+  *  Theorem 2: C Euclidean self-dual iff h = h* and g = f*.
+
+WHAT THIS SCRIPT DOES
+  1. builds A = M_2(F_2) concretely with the paper's omega, i, u and checks
+     the paper's relations; builds the isomorphism F_4 -> <I, omega> and the
+     decomposition A = F_4 (+) u F_4;
+  2. enumerates ALL right ideals of R_n EXHAUSTIVELY (lattice closure of all
+     principal right ideals over the whole ambient set), for n = 1 and n = 3;
+  3. builds, for every ordered assignment of the irreducible factors of
+     X^n-1 to (f,g,h), the three possible readings of the paper's formula
+       R1 : C = { r + u t : r in (fh), t in (f) }        ("u(f)"  reading)
+       R2 : C = { r + u t : r in (fh), t in (fg)}        ("u(fg)" reading,
+                                                          literal)
+       R3 : the right ideal of R_n generated by {fh, u f g}
+     and records for each: size, whether it is a right ideal, its residue,
+     its torsion, and which of the enumerated right ideals it is;
+  4. compares with the enumeration and reports the gap;
+  5. tests Lemma 2 directly at n = 1 (R(X+1) is isomorphic to A as a right
+     A-module, so its right A-submodules are the right ideals of A);
+  6. tests Lemma 4 / Theorem 2 (Euclidean duality) in three variants.
+"""
+import sys
+import time
+import itertools
+
+from matrix_ring_lib import (FiniteField, rref, nullspace, row_space_basis,
+                             in_span, intersect)
+
+LINES = []
