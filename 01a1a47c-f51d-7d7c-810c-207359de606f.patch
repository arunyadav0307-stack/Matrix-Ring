+            say("         f=%s g=%s h=%s : dim C=%d ; C = C^perp_euclid ? %s ; "
+                "C = C^perp_transpose ? %s"
+                % (ptrim(r["f"]), ptrim(r["g"]), ptrim(r["h"]), r["dim"],
+                   key(Dp) == key(r["C"]), key(Dt) == key(r["C"])))
+
+    say("")
+    say("   [elapsed %.1f s]" % (time.time() - t0))
+    with open("alahmadi_reconciliation_log.txt", "w") as fh:
