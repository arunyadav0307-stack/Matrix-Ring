+
+
+def check(name, ok, detail="", exhaustive=True):
+    NCHECK[0] += 1
+    say("  %s %-66s %s  %s"
+        % ("[EXH]" if exhaustive else "[SMP]", name, "PASS" if ok else "**FAIL**", detail))
