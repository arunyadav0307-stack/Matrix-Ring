+                                             [amb.vec(fh), amb.vec(fg_u)])))
+        # variant C : residue + torsion,  C = { r + u t }
+        Rcode = f4_cyclic_code(fh)
+        Tcode = f4_cyclic_code(f)
+        vecs = []
+        for r in Rcode:
