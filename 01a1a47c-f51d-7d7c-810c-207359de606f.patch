+    say("#  B = A_t[X]/<X^n-1> at (q,t,n) = %s   |B| = %d, |B^2| = %d, |S| = %d"
+        % (tag, Br.size, len(P.elems), S.size))
+    say("#  (|S| too large for an exhaustive ideal scan: submodules exhaustive,")
+    say("#   mu_S by exhibited generators + Nakayama lower bound)")
+    say("#" * 96)
