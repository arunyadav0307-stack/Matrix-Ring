+    check("%s [CONJECTURE, dedicated probe]: Hull_s(C^{perp_s}) = Hull_s(C)"
+          % tag, set_bad == 0, "%d nonzero hulls, %d differ" % (nz, set_bad),
+          False)
+
+
+def run_case(q, t, n, sample=40):
