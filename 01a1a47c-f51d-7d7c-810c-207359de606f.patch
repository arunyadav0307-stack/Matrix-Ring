+                say("             residue dim %d (F_4-closed %s, cyclic %s), "
+                    "torsion dim %d (F_4-closed %s, cyclic %s)"
+                    % (len(rb), rcl, rsh, len(tb), tcl, tsh))
+                # is it of the form R + uT with R,T quaternary cyclic ?
+                say("             C = residue + u*torsion ?  %s"
+                    % (len(b) == len(rb) * 2 + len(tb) * 2))
+        results.setdefault("rows1", {})[n] = rows1
+        results.setdefault("rows2", {})[n] = rows2
+
+    # ---------------- 5. duality -------------------------------------------
+    say("")
+    say("=" * 78)
+    say("5. EUCLIDEAN DUALITY (Lemma 4, Theorem 2) AT n = 3")
+    say("=" * 78)
+    n = 3
+    N = 4 * n
+    ideals = results[3][0]
+    rows1 = results["rows1"][3]
+
+    def dual_generic(C, pairfn):
+        """returns basis of {y : pairfn(x,y) = 0 for all x in C}"""
+        rows = []
+        for x in C:
+            M = []
+            for j in range(N):
+                ej = [0] * N
+                ej[j] = 1
+                ej = tuple(ej)
+                val = pairfn(x, ej)          # element of A (4 bits)
+                M.append(bits(val))
+            for t in range(4):
+                rows.append(tuple(M[j][t] for j in range(N)))
+        return nullspace(F2, rows, N)
+
+    def pair_euclid(x, y):
+        wx, wy = from_flat(x), from_flat(y)
+        acc = ZERO
+        for e in range(n):
+            acc = ADD[acc][MUL[wx[e]][wy[e]]]
+        return acc
+
+    def pair_transpose(x, y):
+        wx, wy = from_flat(x), from_flat(y)
+        acc = ZERO
+        for e in range(n):
+            a, b, c, d = bits(wx[e])
+            wt = m2(a, c, b, d)              # transpose
+            acc = ADD[acc][MUL[wt][wy[e]]]
+        return acc
+
+    say("   Euclidean form used by the paper:  sum_j x_j y_j")
+    nself_plain = nself_tr = 0
+    dists_plain = {}
+    dists_tr = {}
+    for b in ideals:
+        Dp = dual_generic(b, pair_euclid)
+        Dt = dual_generic(b, pair_transpose)
+        dists_plain[len(b) + len(Dp)] = dists_plain.get(len(b) + len(Dp), 0) + 1
+        dists_tr[len(b) + len(Dt)] = dists_tr.get(len(b) + len(Dt), 0) + 1
+        if key(Dp) == key(b):
+            nself_plain += 1
+        if key(Dt) == key(b):
+            nself_tr += 1
+    say("   over all %d cyclic codes:" % len(ideals))
+    say("      dim(C) + dim(C^perp_euclid) distribution (should be %d): %s"
+        % (N, sorted(dists_plain.items())))
+    say("      dim(C) + dim(C^perp_transpose) distribution (should be %d): %s"
+        % (N, sorted(dists_tr.items())))
+    say("      C = C^perp  with the Euclidean form sum x_j y_j   : %d codes"
+        % nself_plain)
+    say("      C = C^perp  with the form sum x_j^T y_j           : %d codes"
+        % nself_tr)
+    # Lemma 4 test
+    say("")
+    say("   Lemma 4 test: for each triple (f,g,h) with code C, is the dual")
+    say("   equal to the code built from (f',g',h') = (g*, f*, h*) ?")
+    idx_of = {}
+    for j, b in enumerate(ideals):
+        idx_of[key(b)] = j
+    def key3(f, g, h):
+        return (tuple(ptrim(f)), tuple(ptrim(g)), tuple(ptrim(h)))
+
+    bydata = {}
+    for r in rows1:
+        bydata[key3(r["f"], r["g"], r["h"])] = r
+    cnt_p = cnt_t = 0
+    for r in rows1:
+        f, g, h = ptrim(r["f"]), ptrim(r["g"]), ptrim(r["h"])
+        fs = reciprocal(F4, f) if f else [1]
+        gs = reciprocal(F4, g) if g else [1]
+        hs = reciprocal(F4, h) if h else [1]
+        target = bydata.get(key3(gs, fs, hs))
+        if target is None:
+            continue
+        Dp = dual_generic(r["C"], pair_euclid)
+        Dt = dual_generic(r["C"], pair_transpose)
+        if key(Dp) == key(target["C"]):
+            cnt_p += 1
+        if key(Dt) == key(target["C"]):
+            cnt_t += 1
+    say("      matches with the Euclidean form   sum x_j y_j   : %d/%d"
+        % (cnt_p, len(rows1)))
+    say("      matches with the form             sum x_j^T y_j : %d/%d"
+        % (cnt_t, len(rows1)))
+    stable_rows = [r for r in rows1 if r["stable"]]
+    cntp2 = cntt2 = 0
+    for r in stable_rows:
+        f, g, h = ptrim(r["f"]), ptrim(r["g"]), ptrim(r["h"])
+        fs = reciprocal(F4, f) if f else [1]
+        gs = reciprocal(F4, g) if g else [1]
+        hs = reciprocal(F4, h) if h else [1]
+        target = bydata.get(key3(gs, fs, hs))
+        if target is None:
+            continue
+        if key(dual_generic(r["C"], pair_euclid)) == key(target["C"]):
+            cntp2 += 1
+        if key(dual_generic(r["C"], pair_transpose)) == key(target["C"]):
+            cntt2 += 1
+    say("      restricted to the %d triples with f,g,h in F_2[X] (those for "
+        "which C really is a cyclic code):" % len(stable_rows))
+    say("          matches with sum x_j y_j   : %d/%d" % (cntp2, len(stable_rows)))
+    say("          matches with sum x_j^T y_j : %d/%d" % (cntt2, len(stable_rows)))
+    say("")
+    say("   The self-dual cyclic codes of length 3 (form sum_j x_j^T y_j):")
+    hit1 = set(key(r["C"]) for r in rows1 if r["idx"] is not None)
+    for j, b in enumerate(ideals):
+        Dt = dual_generic(b, pair_transpose)
