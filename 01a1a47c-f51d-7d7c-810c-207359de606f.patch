+            continue
+        lo, up = known[key]
+        say("   [[%2d,%2d,%s]]_%d %s | %-4s | [[%2d,%2d,%d]]_%d (%d..%d)   | %s"
+            % (r["N"], r["K"], r["d"], r["q"],
