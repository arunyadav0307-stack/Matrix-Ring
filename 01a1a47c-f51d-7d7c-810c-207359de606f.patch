@@ -0,0 +1,80 @@
+%% Generated by tools/make_bbl.py using pybtex (plain style).
+%% A real BibTeX run with plain.bst produces an equivalent file.
+%% Do not edit by hand.
+\begin{thebibliography}{10}
+
+\bibitem[1]{Alahmadi2013CyclicM2F2}
+Adel Alahmadi, Houda Sboui, Patrick Sol{é}, and Olfa Yemen.
+\newblock Cyclic codes over {$M_2(\mathbb {F}_2)$}.
+\newblock \emph{Journal of the Franklin Institute}, 350(9):2837–2847, 2013.
+\newblock \href{https://doi.org/10.1016/j.jfranklin.2013.06.008}{doi:10.1016/j.jfranklin.2013.06.008}.
+
