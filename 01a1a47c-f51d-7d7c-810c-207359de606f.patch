+        print("      reflexive (C^perp^perp = C)              : %d/%d"
+              % (refl, len(codes)))
+
+
+def main():
+    print("AUDIT: trace-valued vs matrix-valued theta_s duality, and the")
+    print("       sigma_{2s} isometry properties (decision U9)")
+    print("run: %s" % time.strftime("%Y-%m-%d %H:%M:%S"))
