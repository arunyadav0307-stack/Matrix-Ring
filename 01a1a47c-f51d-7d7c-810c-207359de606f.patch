+    say("      double dual = sigma_{2s}(C) : %d/%d" % (cnt["dd"], cnt["total"]))
+    say("      REFLEXIVE (C^perp)^perp = C : %d/%d" % (cnt["refl"], cnt["total"]))
+    if plain_also:
+        say("      plain product size formula : %d/%d" % (cnt["plain_size"], cnt["total"]))
+    return cnt
