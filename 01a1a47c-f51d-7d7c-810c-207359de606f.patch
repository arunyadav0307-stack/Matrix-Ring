+    elems = list(range(F.q))
+    sub = xs[:150]
+
+    # 3.1  commutation with T (plain commutation of maps on R^n)
+    for k in k_list:
+        check("T sigma_%d = sigma_%d T  (plain commutation)" % (k, k),
