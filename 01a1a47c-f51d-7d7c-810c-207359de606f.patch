+        check("%s: mu_S from the exhaustive x-scan agrees with the ideal lattice BFS"
+              % tag, not badS, "%d right ideals scanned" % npass)
+
+        # mu_S via Nakayama (independent method 3)
+        actS = []
+        for N in S.gens_as_fq_algebra():
+            def g(v, N=N):
