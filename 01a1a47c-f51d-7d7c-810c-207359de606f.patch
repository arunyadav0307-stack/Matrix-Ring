+        ("dimC", "dot-dual", "dot perfect?", "theta-dual",
+         "theta perfect?", "hull(dot)", "hull(theta)", "hull(tr-th)",
+         "hull R-mod"))
+    for r in out["right_rows"]:
+        say("  %-5d | %-14s %-14s | %-14s %-14s | %-11d %-11d %-11d %-11s" % (
+            r["dim"],
+            "%d" % r["dot_dual_dim"],
+            "OK" if r["dot_perfect"] else "BAD",
+            "%d" % r["theta_dual_dim"],
