+                    "characteristic 2, the standard form is not)")
+
+        # ---- C6, D1  per-code checks -------------------------------------
+        nC = nD = nDim = nE = nQc = nCyc = 0
+        euc_mis = herm_mis = 0
+        mu_hull_dist = {}
+        mu = 0
+        witnesses = []
