+              % (e4, len(codes)))
+        print("      (E5) Hull(sigma_k C) = sigma_k Hull(C)   : %d/%d"
+              % (e5, len(codes)))
+        print("      (E6) (C^perp)^perp = sigma_{2s}(C)       : %d/%d"
+              % (e6, len(codes)))
+        refl = sum(1 for C in codes
+                   if key(F, dual_matrix(F, dual_matrix(F, C, m, n, s),
