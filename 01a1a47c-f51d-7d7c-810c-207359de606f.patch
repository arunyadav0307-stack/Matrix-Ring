+def experiment_E4():
+    F, A, R = make_ring(2, 1, 1, 2)          # R = M_2(F_2)
+    amb = Ambient(R, 3)                       # length n = 3
+    out = dict(ambient_dim=amb.dim, ring_size=16)
+    for side in ("right", "left", "two-sided"):
