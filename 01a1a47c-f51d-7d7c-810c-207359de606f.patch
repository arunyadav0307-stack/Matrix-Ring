+
+
+# ==========================================================================
+# B.  actions on R_n = M_2(B)
+# ==========================================================================
+
+def part_B(p, r, t, n):
+    F = Field(p, r)
+    A = Local(F, t)
+    B = PolyQuot(A, n)
+    M = Mat2B(B)
+    R = MatRing(A, 2)
+    say("")
+    say("B    actions on R_n = M_2(B), B = A_t[X]/<X^n-1>      q = %d, t = %d, n = %d"
+        % (F.q, t, n))
