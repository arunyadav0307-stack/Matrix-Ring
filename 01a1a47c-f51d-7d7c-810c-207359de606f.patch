+            "; ".join(unmatched) or "all matched")
+    rep.add("V3b", "every environment is provided by a loaded package",
+            not unknown, ", ".join(sorted(set(unknown))) or "all known")
+
+    # ---------------- V4/V5  labels ----------------------------------------
+    labels = {}
+    dupes = []
+    for f, t in sorted(texts.items()):
+        for m in re.finditer(r"\\label\{([^}]*)\}", t):
+            lab = m.group(1)
+            if lab in labels:
