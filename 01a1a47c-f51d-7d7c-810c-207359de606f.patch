+    task_f()
+    task_f_hull_principality()
+    head("TASK G -- boundary cases")
+    boundary_cases()
+    head("summary")
+    nfail = len(FAILURES)
+    say("  %d checks, %d PASS, %d FAIL" % (NCHECK[0], NCHECK[0] - nfail, nfail))
+    if FAILURES:
+        say("  failures:")
+        for f in FAILURES:
+            say("     %s  --  %s" % (f[0], f[1]))
+    else:
+        say("  no failures")
+    say("  end of log")
+    with open(LOGNAME, "w") as fh:
+        fh.write("\n".join(LINES) + "\n")
+
