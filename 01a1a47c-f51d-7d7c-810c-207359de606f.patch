+                break
+        if not ok:
+            continue
+        gens = []
+        for w in Rb:
+            for j in range(2):
+                vv = [0] * Rt2.d
+                for i in range(2):
+                    for l in range(2):
+                        # MatRing.vec order: index = (i*m+j)*t + l
+                        vv[(i * 2 + j) * 2 + l] = w[i * 2 + l]
+                gens.append(tuple(vv))
+        codes_t2.append(rref(F4b, gens, Rt2.d)[0] if gens else [])
