+        found["A"].add(tuple(amb.close_under(imgs,
+                                             [amb.vec(fh), amb.vec(u_fg)])))
+        # variant B : right ideals, u on the right
+        fg_u = tuple(R.mul(fg[k], u) for k in range(n))
