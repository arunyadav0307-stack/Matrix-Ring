+    nfail = len(FAILURES)
+    say("  %d checks, %d PASS, %d FAIL"
+        % (NCHECK[0], NCHECK[0] - nfail, nfail))
+    if FAILURES:
+        say("  failures:")
+        for f in FAILURES:
+            say("     %s  --  %s" % (f[0], f[1]))
+    else:
+        say("  no failures")
