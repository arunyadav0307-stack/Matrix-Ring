+    scanB = Be if len(Be) <= 500 else random.Random(21).sample(Be, 500)
+
+    check("X is CENTRAL in B:  Xb = bX for all b in B",
+          all(B.mul(B.X, b) == B.mul(b, B.X) for b in Be),
+          exhaustive=(len(Be) <= 20000))
