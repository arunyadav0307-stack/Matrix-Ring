+def quantum_hamming_bound(N, K, d, q):
+    """sum_{i<=t} C(N,i)(q^2-1)^i * q^K <= q^N  (t = floor((d-1)/2))"""
+    t = (d - 1) // 2
+    tot = 0
+    for i in range(t + 1):
+        tot += _comb(N, i) * (q * q - 1) ** i
+    return tot * q ** K <= q ** N
+
