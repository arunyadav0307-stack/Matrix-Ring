+SCAN_FAMILIES = [(4, 1, 1), (4, 1, 2), (4, 1, 3), (4, 1, 4), (4, 1, 5),
+                 (4, 1, 6), (4, 2, 1), (4, 2, 2), (4, 2, 3), (4, 3, 1),
+                 (4, 4, 1),
+                 (8, 1, 1), (8, 1, 2), (8, 1, 3), (8, 3, 1),
+                 (9, 1, 1), (9, 1, 2), (9, 1, 3), (9, 1, 4), (9, 1, 5),
