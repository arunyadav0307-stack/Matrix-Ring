+# ---- B = F_q[X]/<X^n-1> (cyclic convolution) -----------------------------
+class Quotient(object):
+    def __init__(self, F, n):
+        self.F, self.n = F, n
+        self.zero = tuple([0] * n)
+        self.one = (1,) + tuple([0] * (n - 1))
+
+    def add(self, a, b):
+        F = self.F
+        return tuple(F.add[a[i]][b[i]] for i in range(self.n))
+
+    def mul(self, a, b):
+        F = self.F
+        n = self.n
+        out = [0] * n
+        for i in range(n):
+            if a[i]:
+                for j in range(n):
+                    if b[j]:
+                        k = (i + j) % n
+                        out[k] = F.add[out[k]][F.mul[a[i]][b[j]]]
+        return tuple(out)
+
+    def elements(self):
+        return itertools.product(range(self.F.q), repeat=self.n)
+
+    def vec(self, a):
+        return tuple(a)
+
