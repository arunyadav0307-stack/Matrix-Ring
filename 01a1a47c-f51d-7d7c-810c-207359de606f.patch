+    return "[[%d,%d,%s]]_%d" % (N, r["K"], r["d"], q)
+
+
+def safe(s):
+    return (str(s).replace("[", "").replace("]", "")
+            .replace(";", "-").replace(",", "_").replace(" ", ""))
+
+
+def main():
