+            % (q, t, n, s, N, stats["codes"],
+               "EXHAUSTIVE" if stats["exh"] else "SAMPLE(300)",
+               stats["SO"], stats["DC"], stats["so_quantum"],
+               stats["dc_quantum"], stats["ea"]))
+    return all_rows
