+    check("(%d,%d,%d): w_ent <= w_coef <= t w_ent" % (q, t, n), ok2,
+          "%d words" % len(words), exh)
+    check("(%d,%d,%d): w_H <= wt_Ham(phi_n(x)) <= 4t w_H" % (q, t, n), ok3,
+          "%d words" % len(words), exh)
