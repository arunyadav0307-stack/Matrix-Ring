+                    "sigma_s(T)^T J T = I :  %s" % (s, JTs == ident))
+        else:
+            say("       NO per-block congruence T^T H_t T = I_t exists for "
+                "(q,t) = (%d,%d)  (search %s)" % (q, t,
+                "exhaustive" if q ** (t * t) <= 300000 else "sampled"))
