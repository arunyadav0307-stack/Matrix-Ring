+             (4, 12, 8): (2, 2), (4, 8, 4): (2, 2),
+            (4, 24, 16): (3, 3), (4, 24, 8): (5, 5), (4, 12, 2): (4, 4),
+            (4, 12, 4): (4, 4), (4, 24, 4): (6, 8), (4, 24, 2): (7, 8),
+            (4, 24, 20): (2, 2), (4, 24, 12): (4, 5), (4, 20, 12): (3, 3),
+            (4, 20, 8): (4, 5)}
+    shown = 0
