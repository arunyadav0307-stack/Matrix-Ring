+# parameter sets where the whole submodule lattice of B^2 can be enumerated by BFS
+BFS_FEASIBLE = [(4, 1, 1), (4, 1, 2), (4, 2, 1), (4, 2, 2), (4, 1, 3),
+                (9, 1, 2), (8, 1, 2)]
